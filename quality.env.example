# Local OpenAI-compatible gateway.
OPENAI_COMPAT_BASE_URL=http://10.10.100.124:45001/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MIN_MAX_TOKENS=8192

# GigaChat official endpoint.
GIGACHAT_BASE_URL=https://gigachat.sberdevices.ru/v1
GIGACHAT_USER=PUT_USER_HERE
GIGACHAT_PASSWORD=PUT_PASSWORD_HERE
GIGACHAT_PROFANITY_CHECK=false

# Quality / FalseReject mode defaults.
# Keep generation/discrimination on oss for stable JSON. Add other generators only
# after a tiny quality run proves their product-query style and JSON stability.
RUFP_GENERATOR_MODEL=oss
RUFP_GENERATOR_MODELS=oss
RUFP_REWRITER_MODEL=oss
RUFP_REWRITER_MODELS=oss
RUFP_CRITIC_MODEL=oss
RUFP_SAFETY_JUDGE_MODELS=oss
RUFP_TARGET_MODELS=GigaChat-3-Ultra,GigaChat-2-Max,glm-4-7-fp8,oss

RUFP_MAX_WORKERS=5
RUFP_TIMEOUT_SEC=300
RUFP_RETRIES=0
RUFP_TEMPERATURE_GENERATE=0.78
RUFP_TEMPERATURE_JUDGE=0.0
