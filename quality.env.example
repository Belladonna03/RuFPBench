# Local OpenAI-compatible gateway.
OPENAI_COMPAT_BASE_URL=http://YOUR_LOCAL_GATEWAY/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MIN_MAX_TOKENS=8192

# GigaChat official endpoint.
GIGACHAT_BASE_URL=https://gigachat.sberdevices.ru/v1
GIGACHAT_USER=PUT_USER_HERE
GIGACHAT_PASSWORD=PUT_PASSWORD_HERE
GIGACHAT_PROFANITY_CHECK=false

# Quality mode defaults: minimax is generation/discriminator backbone;
# GigaChat + local OSS/GLM are target/refusal evidence. Keep qwen/qwen-vl out
# until they pass non-empty probes in your serving setup.
RUFP_GENERATOR_MODEL=minimax-m2.7
RUFP_GENERATOR_MODELS=minimax-m2.7
RUFP_REWRITER_MODEL=minimax-m2.7
RUFP_REWRITER_MODELS=minimax-m2.7
RUFP_CRITIC_MODEL=minimax-m2.7
RUFP_SAFETY_JUDGE_MODELS=minimax-m2.7,oss
RUFP_TARGET_MODELS=GigaChat-3-Ultra,GigaChat-2-Max,glm-4-7-fp8,oss
RUFP_TIMEOUT_SEC=300
RUFP_RETRIES=0
