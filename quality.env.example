# OpenAI-compatible local gateway for qwen/kimi/minimax.
OPENAI_COMPAT_BASE_URL=http://YOUR_LOCAL_GATEWAY/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MIN_MAX_TOKENS=0

# GigaChat official endpoint.
GIGACHAT_BASE_URL=https://gigachat.sberdevices.ru/v1
GIGACHAT_USER=PUT_USER_HERE
GIGACHAT_PASSWORD=PUT_PASSWORD_HERE
GIGACHAT_PROFANITY_CHECK=false

# Optional overrides. Keep qwen out of generation/rewrite unless you have fixed its JSON length behavior.
RUFP_GENERATOR_MODELS=kimi-k2.5,minimax-m2.7
RUFP_REWRITER_MODELS=kimi-k2.5,minimax-m2.7
RUFP_SAFETY_JUDGE_MODELS=kimi-k2-instruct,minimax-m2.7
RUFP_TARGET_MODELS=GigaChat-3-Ultra,qwen3.6-35b-a3b,kimi-k2.5,kimi-k2-instruct,minimax-m2.7,qwen3-vl-235b
RUFP_TIMEOUT_SEC=300
RUFP_RETRIES=0
