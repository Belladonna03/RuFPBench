# -----------------------------------------------------------------------------
# RuFPBench cascade-mining environment template
# -----------------------------------------------------------------------------
# Copy to .env and fill only credentials/endpoints you really use.
# Do not commit .env. The archive intentionally does not include .env.

# 1) Local OpenAI-compatible gateway for free/local models.
# Expected model names in configs/default.yaml:
#   gigachat3-10b
#   oss                  # alias for gpt-oss-120b; gpt-oss-120b is mapped to oss
#   qwen3.6-35b-a3b
#   glm-4-7-fp8
#   qwen3-vl-235b
OPENAI_COMPAT_BASE_URL=http://10.10.100.124:45001/v1
OPENAI_COMPAT_API_KEY=

# Keep this 0 for normal cascade runs. The project now disables token floors
# per step, so scout/final target calls stay short even if you set a high floor
# for probe/debug steps.
OPENAI_COMPAT_MIN_MAX_TOKENS=0

# 2) Official GigaChat endpoint. GigaChat-* models route here through
# llm.pipeline.*.model_provider_map in configs/default.yaml.
GIGACHAT_BASE_URL=https://gigachat.sberdevices.ru/v1
GIGACHAT_USER=PUT_GIGACHAT_USER_HERE
GIGACHAT_PASSWORD=PUT_GIGACHAT_PASSWORD_HERE
GIGACHAT_PROFANITY_CHECK=false

# 3) Optional paid ProxyAPI baseline. Leave empty for bulk mining.
PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1
PROXYAPI_API_KEY=
PROXYAPI_MAX_TOKENS_CAP=900

# -----------------------------------------------------------------------------
# Model profile. Defaults in configs/default.yaml already match this profile;
# uncomment only when you need to override without editing YAML.
# -----------------------------------------------------------------------------
# RUFP_GENERATOR_MODELS=qwen3.6-35b-a3b,oss
# RUFP_REWRITER_MODELS=qwen3.6-35b-a3b,oss
# RUFP_CRITIC_MODEL=oss
# RUFP_TRANSLATOR_MODEL=oss
# RUFP_SAFETY_JUDGE_MODELS=oss,qwen3.6-35b-a3b,GigaChat-2-Max
# RUFP_TARGET_MODELS=gigachat3-10b,oss,qwen3.6-35b-a3b,glm-4-7-fp8,qwen3-vl-235b,GigaChat-2-Max,GigaChat-3-Ultra

# Runtime knobs.
RUFP_MAX_WORKERS=16
RUFP_TIMEOUT_SEC=90
RUFP_RETRIES=1
RUFP_TEMPERATURE_GENERATE=0.85
RUFP_TEMPERATURE_JUDGE=0.0

# Cascade knobs. Lower these for paid/provider-constrained runs.
RUFP_CASCADE_MAX_PROMOTED_PER_ROUND=220
RUFP_CASCADE_MUTATE_PROMISING_PER_ROUND=120
RUFP_CASCADE_CONTROL_SAMPLE_PER_ROUND=24

# Prompt-safety ensemble thresholds.
RUFP_BENIGN_VOTES_REQUIRED=2
RUFP_UNSAFE_VOTES_REQUIRED=2
