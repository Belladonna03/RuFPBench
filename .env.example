# OpenRouter (recommended for dev / free test runs — used by rewrite.llm in config.yaml)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_X_TITLE=RuFPBench-MVP

# Legacy ProxyAPI (optional; still supported if you set these and point config at PROXYAPI_*)
# PROXYAPI_API_KEY=
# PROXYAPI_BASE_URL=https://openai.api.proxyapi.ru/v1
# PROXYAPI_MODEL=openrouter/qwen/qwen3-32b

# RewriteAgent only — ProxyAPI OpenRouter (set these for rewrite; does not replace global OPENROUTER_*)
REWRITE_AGENT_PROXYAPI_API_KEY=
REWRITE_AGENT_PROXYAPI_BASE_URL=https://api.proxyapi.ru/openrouter/v1
REWRITE_AGENT_PROXYAPI_MODEL=qwen/qwen3-8b
REWRITE_AGENT_PROXYAPI_HTTP_REFERER=http://localhost:8000
REWRITE_AGENT_PROXYAPI_X_TITLE=RuFPBench-MVP

# DataCollectionAgent — LLM interpretation of code EDA (optional; code EDA works without key)
DATA_COLLECTION_PROXYAPI_API_KEY=
DATA_COLLECTION_PROXYAPI_BASE_URL=https://api.proxyapi.ru/openrouter/v1
DATA_COLLECTION_PROXYAPI_MODEL=qwen/qwen3-8b
DATA_COLLECTION_PROXYAPI_HTTP_REFERER=http://localhost:8000
DATA_COLLECTION_PROXYAPI_X_TITLE=RuFPBench-MVP
